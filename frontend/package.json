{
  "name": "praxis-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve app",
    "build": "ng build app",
    "watch": "ng build --watch --configuration development",
    "test": "ng test app --watch=false",
    "quality": "npm run lint && npm test && npm run build && npm run format:check",
