{
  "name": "praxis-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve shell",
    "start:shell": "ng serve shell --port 4200",
    "start:news": "ng serve news --port 4201",
    "build": "npm run build:shell && npm run build:news",
    "build:shell": "ng build shell",
    "build:news": "ng build news",
    "watch": "ng build --watch --configuration development",
    "test": "ng test shell --watch=false && ng test news --watch=false",
    "test:shell": "ng test shell --watch=false",
    "test:news": "ng test news --watch=false",
    "test:boundaries": "node --test tools/check-boundaries.test.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "quality": "npm run lint && npm test && npm run test:boundaries && npm run check:boundaries && npm run build && npm run format:check",
    "format:check": "prettier --check .",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.6.0 <12"
  },
  "dependencies": {
    "@angular/animations": "22.1.3",
    "@angular/common": "22.1.3",
    "@angular/compiler": "22.1.3",
    "@angular/core": "22.1.3",
    "@angular/forms": "22.1.3",
    "@angular/platform-browser": "22.1.3",
    "@angular/router": "22.1.3",
    "es-module-shims": "2.8.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "22.1.1",
    "@angular/build": "22.1.5",
    "@angular/cli": "22.1.5",
    "@angular/compiler-cli": "22.1.3",
    "@eslint/js": "10.0.1",
    "angular-eslint": "22.1.0",
    "eslint": "10.6.0",
    "jsdom": "28.0.0",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.11"
  }
}
