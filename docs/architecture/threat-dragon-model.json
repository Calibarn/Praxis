            "data": {
              "type": "tm.Store",
              "name": "MariaDB (praxis_news)",
              "description": "",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "isALog": false,
              "isEncrypted": false,
              "isSigned": false,
              "storesCredentials": false,
              "storesInventory": false,
              "threats": [
                {
                  "id": "3c060f5f-d00e-4779-abff-a50869daa3b0",
                  "title": "Keine Rechtetrennung zwischen Migrations- und Runtime-DB-User",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "Der Backend-Container nutzt denselben MariaDB-Benutzer (news_service) sowohl für automatische Schema-Migrationen (DDL) beim Containerstart als auch für normale Lese-/Schreibzugriffe zur Laufzeit.",
                  "mitigation": "Zwei DB-User trennen: ein Migrations-User mit DDL-Rechten, nur für den Deploy-/Migrationsschritt verwendet, und ein Runtime-User mit auf die news-Tabelle beschränkten DML-Rechten für den langlaufenden App-Prozess.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "e6ab2554-e5c9-4a5f-b491-8315dd717bcb",
                  "title": "Rechte-Eskalation bei Backend-Kompromittierung",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of Privilege",
                  "description": "Wird der Backend-Prozess kompromittiert (z. B. künftige Dependency-RCE), erbt ein Angreifer wegen Finding 1 auch Schema-Änderungsrechte, nicht nur Lese-/Schreibzugriff auf Daten.",
                  "mitigation": "Siehe Mitigation zu Finding 1 (Rechtetrennung). Zusätzlich: geringstmögliche Rechte für den Runtime-User (kein DROP/ALTER).",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                }
              ]
            }
